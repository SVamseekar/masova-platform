# MaSoVa Frontend - Production Dockerfile
# This creates a lightweight nginx container serving the React app

# Stage 1: Build the React app
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the app
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
# 127.0.0.1, not localhost: the container resolves "localhost" to ::1 (IPv6) first,
# but nginx.conf only has "listen 80" (IPv4) - the image's own ipv6-listen auto-patch
# entrypoint script skips customized configs, so wget to localhost gets connection
# refused even though nginx is up and serving on IPv4.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
