{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "docs": "typedoc --out docs --entryPointStrategy expand ./src --skipErrorChecking",
    "docs:json": "typedoc --json docs/documentation.json --entryPointStrategy expand ./src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.7",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.4.0",
    "@react-google-maps/api": "^2.20.8",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.14.0",
    "@stomp/stompjs": "^7.5.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@types/axios": "^0.14.4",
    "@types/leaflet": "^1.9.22",
    "@types/react-router-dom": "^5.3.3",
    "async-mutex": "^0.5.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.18",
    "framer-motion": "^14.14.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.75.0",
    "notistack": "^3.0.2",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^3.4.19",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unused-imports": "^4.4.1",
