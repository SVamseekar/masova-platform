{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:pact": "vitest run --config vitest.pact.config.ts",

    "docs": "typedoc --out docs --entryPointStrategy expand ./src --skipErrorChecking",
    "docs:json": "typedoc --json docs/documentation.json --entryPointStrategy expand ./src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@react-google-maps/api": "^2.20.8",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@stomp/stompjs": "^7.3.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.1.0",
    "@types/axios": "^0.14.4",
    "@types/leaflet": "^1.9.22",
    "@types/react-router-dom": "^5.3.3",
    "async-mutex": "^0.5.0",
    "autoprefixer": "^10.5.6",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "framer-motion": "^11.18.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "notistack": "^3.0.2",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sockjs-client": "^1.6.1",
    "tailwindcss": "^3.4.19",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@pact-foundation/pact": "^16.0.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
