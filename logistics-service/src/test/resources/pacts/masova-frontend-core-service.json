{
  "consumer": {
    "name": "masova-frontend"
  },
  "interactions": [
    {
      "description": "a login request with an invalid password",
      "providerStates": [
        {
          "name": "a user exists with email pact-login@masova.com and password Pact-Password123"
        }
      ],
      "request": {
        "body": {
          "email": "pact-login@masova.com",
          "password": "wrong-password"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/auth/login"
      },
      "response": {
        "status": 500
      }
    },
    {
      "description": "a login request with valid credentials",
      "providerStates": [
        {
          "name": "a user exists with email pact-login@masova.com and password Pact-Password123"
        }
      ],
      "request": {
        "body": {
          "email": "pact-login@masova.com",
          "password": "Pact-Password123"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/auth/login"
      },
      "response": {
        "body": {
          "accessToken": "eyJhbGciOiJIUzUxMiJ9.example.token",
          "refreshToken": "eyJhbGciOiJIUzUxMiJ9.example.refresh",
          "user": {
            "email": "pact-login@masova.com",
            "id": "USER-PACT-LOGIN-1",
            "type": "CUSTOMER"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.refreshToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to get store by ID",
      "providerStates": [
        {
          "name": "store exists with id STORE-PACT-1"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/stores/STORE-PACT-1"
      },
      "response": {
        "body": {
          "address": {
            "city": "Berlin"
          },
          "id": "STORE-PACT-1",
          "name": "MaSoVa Berlin"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.address.city": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to get user by ID",
      "providerStates": [
        {
          "name": "user exists with id USER-PACT-1"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/users/USER-PACT-1"
      },
      "response": {
        "body": {
          "email": "john.manager@example.com",
          "id": "USER-PACT-1",
          "name": "John Manager",
          "type": "MANAGER"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "core-service"
  }
}